<Window x:Class="sberbank.View.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сбербанк - регистрация"
        Height="620"
        Width="580"
        MinHeight="560"
        MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="28"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Регистрация клиента" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Создание учетной записи для работы с услугами банка"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,20"/>

                    <Label Content="ФИО"/>
                    <TextBox x:Name="FullNameTextBox"/>
                    <Label Content="Телефон"/>
                    <TextBox x:Name="PhoneTextBox"/>
                    <Label Content="Email"/>
                    <TextBox x:Name="EmailTextBox"/>
                    <Label Content="Логин"/>
                    <TextBox x:Name="LoginTextBox"/>
                    <Label Content="Пароль"/>
                    <PasswordBox x:Name="PasswordBox"/>

                    <TextBlock Text="Пароль: больше 4 символов, минимум 1 цифра, 1 заглавная буква и 1 специальный символ."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                    <Button Content="Зарегистрироваться" Click="RegisterButton_Click" Height="40"/>
                    <Button Content="Назад ко входу" Style="{StaticResource SecondaryButton}" Click="BackButton_Click" Height="38"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
