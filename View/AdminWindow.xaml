<Window x:Class="sberbank.View.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Сбербанк - администрирование" Height="760" Width="1180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,0">
                <TextBlock Text="Админ-панель Сбербанк" Foreground="{StaticResource PrimaryBrush}" FontSize="24"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Выйти" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="LogoutButton_Click"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchTextBox" Width="260" Margin="0,3,8,3"/>
                    <Button Content="Поиск" Click="SearchButton_Click"/>
                    <Button Content="Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Добавить строку" Style="{StaticResource SecondaryButton}" Click="AddButton_Click"/>
                    <Button Content="Удалить строку" Style="{StaticResource SecondaryButton}" Click="DeleteButton_Click"/>
                    <Button Content="Сохранить" Click="SaveButton_Click"/>
                    <Button Content="Экспорт CSV" Style="{StaticResource SecondaryButton}" Click="ExportButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="AdminTabs" Grid.Row="2" Margin="18" SelectionChanged="AdminTabs_SelectionChanged">
            <TabItem Header="Пользователи">
                <DataGrid x:Name="UsersDataGrid"/>
            </TabItem>
            <TabItem Header="Клиенты">
                <DataGrid x:Name="ClientsDataGrid"/>
            </TabItem>
            <TabItem Header="Услуги">
                <DataGrid x:Name="ProductsDataGrid"/>
            </TabItem>
            <TabItem Header="Заявки">
                <DataGrid x:Name="ApplicationsDataGrid" IsReadOnly="True"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Статус выбранной заявки:" VerticalAlignment="Center" Margin="6,0"/>
                <ComboBox x:Name="StatusComboBox" DisplayMemberPath="Name" SelectedValuePath="StatusId" Width="190" Margin="8,0"/>
                <Button Content="Изменить статус" Click="ChangeStatusButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
